# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o Git.
# Precisou de uma variavel nova? Adicione aqui tambem, com valor ficticio.

# Banco de dados (PostgreSQL)
# No Docker Compose o host e "db" (nome do servico do banco na rede do
# compose), nao "localhost": dentro do container, localhost e o proprio app.
# Rodando a API fora do Docker (uvicorn local), use POSTGRES_HOST=localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=sistema_estoque
POSTGRES_USER=estoque_app
POSTGRES_PASSWORD=estoque123

# Chave que assina o cookie de sessao (minimo de 32 caracteres).
# O valor abaixo e so para desenvolvimento local. NAO use em producao:
# gere a sua com python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=INSEGURA_apenas_dev_local_NAO_USE_EM_PRODUCAO
